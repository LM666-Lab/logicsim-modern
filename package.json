{
  "name": "logicsim-modern",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "逻辑表达式可视化工具 —— 将逆波兰逻辑表达式转换为二元决策图 (BDD)。2021 年版的现代化重写。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:logic": "node tests/logic.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs"
  },
  "dependencies": {
    "@joint/core": "^4.3.3",
    "@joint/layout-directed-graph": "^4.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  }
}
